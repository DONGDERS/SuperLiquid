<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <queries>
        <package android:name="com.tencent.mm" />
        <package android:name="com.tencent.mobileqq" />
        <package android:name="tv.danmaku.bili" />
        <package android:name="com.max.xiaoheihe" />
        <package android:name="com.kugou.android" />
        <package android:name="com.xunmeng.pinduoduo" />
        <package android:name="com.taobao.taobao" />
    </queries>

    <application
        android:enableOnBackInvokedCallback="true"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:hasCode="true"
        android:supportsRtl="true"
        android:theme="@style/Theme.SuperLiquid">

        <provider
            android:name=".PinduoduoTabLabelProvider"
            android:authorities="${applicationId}.pdd_tab_label"
            android:exported="true" />

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <action android:name="android.intent.action.APPLICATION_PREFERENCES" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
